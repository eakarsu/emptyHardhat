{
  "name": "milestone-escrow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tenant-governed milestone escrow with independent evidence approval",
  "overrides": {
    "adm-zip": "0.6.0",
    "serialize-javascript": "7.0.7"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "check": "npm run compile && npm test && solhint --max-warnings 0 'contracts/**/*.sol'",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy.js",
    "deploy:production": "hardhat run --network production scripts/deploy.js",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-mocha": "3.0.21",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "hardhat": "3.10.0",
    "mocha": "11.3.0",
    "solhint": "6.2.3"
  }
}
